 
# Database
   DATABASE_URL=postgresql://asembleai:asembleai123@localhost:5432/asembleai
   REDIS_URL=redis://localhost:6379/0
   
# Security
   JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-abc123xyz789
   JWT_ALGORITHM=HS256
   JWT_EXPIRATION_MINUTES=1440
   
# Server
   PORT=8000
   HOST=0.0.0.0
   DEBUG=true
   ENVIRONMENT=development
   
# CORS
   CORS_ORIGINS=["http://localhost:3001","http://localhost:5173","http://localhost:3000"]
   
# AI APIs
   OPENAI_API_KEY=sk-proj-YOUR_ACTUAL_KEY_HERE
   OPENAI_MODEL=gpt-4-turbo-preview
   
# GitHub
   GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
   GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
   GITHUB_PERSONAL_ACCESS_TOKEN=ghp_YOUR_GITHUB_TOKEN
   
# File Storage (local for now)
   STORAGE_TYPE=local
   STORAGE_PATH=/tmp/asembleai-storage